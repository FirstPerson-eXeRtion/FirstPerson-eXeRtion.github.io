---
import Icon from './Icon.astro';
---
<div class="scene-wrap">
  <div class="xr-scene" aria-hidden="true">
    <div class="scene-aura"></div>
    <div class="scene-grid"></div>
    <svg class="motion-world" viewBox="0 0 680 610" fill="none">
      <defs>
        <linearGradient id="trail" x1="58" y1="464" x2="560" y2="105" gradientUnits="userSpaceOnUse"><stop stop-color="#66dedf" stop-opacity="0"/><stop offset=".45" stop-color="#66dedf"/><stop offset="1" stop-color="#a997ec" stop-opacity=".2"/></linearGradient>
        <linearGradient id="body" x1="298" y1="182" x2="400" y2="446" gradientUnits="userSpaceOnUse"><stop stop-color="#74e3e3" stop-opacity=".36"/><stop offset="1" stop-color="#9a89e8" stop-opacity=".08"/></linearGradient>
        <linearGradient id="edge" x1="250" y1="230" x2="427" y2="469" gradientUnits="userSpaceOnUse"><stop stop-color="#9ceeed"/><stop offset="1" stop-color="#a99bed" stop-opacity=".6"/></linearGradient>
        <radialGradient id="floor"><stop stop-color="#79a9d5" stop-opacity=".11"/><stop offset="1" stop-color="#79a9d5" stop-opacity="0"/></radialGradient>
        <pattern id="mesh" width="14" height="14" patternUnits="userSpaceOnUse"><path d="M0 0 14 14M14 0 0 14" stroke="#95edeb" stroke-width=".5" opacity=".13"/></pattern>
        <clipPath id="avatar-clip"><path d="M359 192c-17-3-31 1-43 15l-38 49-48 2-29 19 9 13 78-12 32-32-20 70-51 45 45 71-12 43 13 13 27-48-32-68 57-28 38 44 62 8 42-13-4-13-38 5-41-18-41-73 15-57 27 27 46-10 31-22-8-12-32 15-27-1-35-45c-7-9-20-13-25-12Z"/></clipPath>
      </defs>
      <ellipse cx="355" cy="484" rx="270" ry="94" fill="url(#floor)"/>
      <g class="orbital-lines" stroke="#85b4d8" stroke-opacity=".16">
        <ellipse cx="350" cy="310" rx="228" ry="226"/>
        <ellipse cx="350" cy="310" rx="174" ry="226" transform="rotate(35 350 310)"/>
        <ellipse cx="350" cy="310" rx="232" ry="74" transform="rotate(-28 350 310)"/>
        <path d="M107 309h475M350 68v475" stroke-dasharray="3 9"/>
      </g>
      <g stroke="#79dfe3" stroke-opacity=".3">
        <ellipse cx="346" cy="492" rx="173" ry="37"/>
        <ellipse cx="346" cy="492" rx="123" ry="25" stroke-dasharray="3 10"/>
        <path d="m167 484-12 4m367-4 14 4M346 444v-9m0 113v-9"/>
      </g>
      <g class="flow-lines" stroke="url(#trail)" stroke-width="1.5">
        <path d="M45 449C132 503 274 450 416 320S628 185 581 126"/>
        <path d="M39 461C127 515 277 461 426 327S639 183 593 127" opacity=".45"/>
        <path d="M58 479C147 522 298 465 437 340S646 187 608 141" opacity=".2"/>
        <path class="moving-trail" d="M45 449C132 503 274 450 416 320S628 185 581 126" stroke="#b4f6f1" stroke-width="2.5" stroke-dasharray="30 700"/>
      </g>
      <g class="hero-avatar">
        <path d="M359 192c-17-3-31 1-43 15l-38 49-48 2-29 19 9 13 78-12 32-32-20 70-51 45 45 71-12 43 13 13 27-48-32-68 57-28 38 44 62 8 42-13-4-13-38 5-41-18-41-73 15-57 27 27 46-10 31-22-8-12-32 15-27-1-35-45c-7-9-20-13-25-12Z" fill="url(#body)" stroke="url(#edge)" stroke-width="1.3"/>
        <path d="M150 150h400v360H150z" fill="url(#mesh)" clip-path="url(#avatar-clip)"/>
        <path d="m326 211 20 35-35 74 31 21m-16-130-40 55-62 9m122-29 26-23 31 42 50-4m-142 59-38 45 35 69-19 45m53-138 51 36 57 11" stroke="#91dfe0" stroke-opacity=".45"/>
        <path d="M346 193c-8-9-12-24-5-39 6-15 20-22 35-19 18 4 24 18 20 35l-10 23-15 9-25-9Z" fill="url(#body)" stroke="url(#edge)" stroke-width="1.3"/>
        <path d="m351 154 49 8-4 16-48-9 3-15Z" fill="#173847" stroke="#a2efeb" stroke-width="1.5"/>
        <path d="m357 158 36 6" stroke="#e0fffd" stroke-width="2"/>
        <g fill="#0e2534" stroke="#b3efec" stroke-width="1.5"><circle cx="326" cy="211" r="4"/><circle cx="286" cy="266" r="3"/><circle cx="346" cy="246" r="3"/><circle cx="311" cy="320" r="4"/><circle cx="273" cy="365" r="3"/><circle cx="393" cy="377" r="3"/></g>
        <path d="m399 168 78-32 67 13-77 42-68-23Z" fill="#71dfe1" fill-opacity=".025" stroke="#71dfe1" stroke-opacity=".22" stroke-dasharray="3 5"/>
      </g>
      <g class="spatial-points" fill="#83e0e1"><circle cx="158" cy="199" r="2.5"/><circle cx="511" cy="373" r="3"/><circle cx="231" cy="451" r="2"/><circle cx="488" cy="93" r="2"/><circle cx="112" cy="366" r="2"/><circle cx="560" cy="267" r="2.5"/></g>
      <g stroke="#b09beb" stroke-opacity=".6"><path d="M185 164h12m-6-6v12M487 427h12m-6-6v12M435 75h10m-5-5v10"/></g>
      <path d="M144 176h49l52 38M502 366h43v-69" stroke="#86cdd7" stroke-opacity=".4" stroke-dasharray="3 4"/>
    </svg>
    <div class="data-panel panel-one"><span class="panel-label"><i></i> SITUATED DATA</span><svg viewBox="0 0 150 55"><path d="M0 44h150M0 24h150M0 4h150" stroke="currentColor" opacity=".12"/><path d="m2 43 17-5 16 3 17-24 16 7 17-17 16 12 17-9 14 4 16-12" fill="none" stroke="currentColor" stroke-width="1.5"/><circle cx="85" cy="7" r="3" fill="currentColor"/></svg><span class="panel-caption">A changing perspective</span></div>
    <div class="data-panel panel-two"><span class="panel-label">INPUT IN MOTION</span><div class="signal-bars">{[25, 48, 33, 62, 80, 56, 93, 72, 48, 67, 39, 24].map(h => <i style={`--bar-height:${h}%`}></i>)}</div><span class="panel-caption">Move · sense · interact</span></div>
    <div class="scene-coordinate">BODY ↔ DATA ↔ WORLD</div>
  </div>
  <button class="motion-toggle" aria-pressed="false" hidden><Icon name="pause" size={13} /><span>Pause motion</span></button>
</div>
